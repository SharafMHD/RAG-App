# FastAPI backend base URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional default knowledge base selected when the UI opens.
NEXT_PUBLIC_DEFAULT_KNOWLEDGE_BASE_ID=

# Optional when backend REQUIRE_API_KEY=true. Sent as X-API-Key.
NEXT_PUBLIC_API_KEY=

# Public display-only service values shown in admin settings. Do not include credentials.
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8000
NEXT_PUBLIC_FLOWER_URL=http://localhost:5555
NEXT_PUBLIC_PROMETHEUS_URL=http://localhost:9090
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3000
NEXT_PUBLIC_LANGFUSE_URL=http://localhost:3001
NEXT_PUBLIC_POSTGRESQL_URL=postgresql://localhost:5400/rag_app_db
NEXT_PUBLIC_RABBITMQ_URL=http://localhost:15672
NEXT_PUBLIC_REDIS_URL=redis://localhost:6379
NEXT_PUBLIC_CELERY_WORKER_URL=celery@localhost
NEXT_PUBLIC_QDRANT_URL=http://localhost:6333/dashboard
