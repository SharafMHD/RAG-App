APP_NAME="RAG APP"
APP_VERSION="0.1.0"
ENVIRONMENT="development"

# Security
API_KEY=""
REQUIRE_API_KEY=false
CORS_ALLOWED_ORIGINS=["*"]
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
TRUSTED_HOSTS=["*"]

# Secrets (fill in)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
COHERE_API_KEY=""

# File upload settings
FILE_ALLOWED_TYPES=["text/plain", "application/pdf"]
FILE_ALLOWED_SIZE=10 # in MB
UPLOAD_DIR="assets/files"
FILE_DEFAULT_CHUNK_SIZE=512000
FILE_OVERLAP_SIZE=5120

# Database
MONGODB_URL="mongodb://admin:admin@localhost:27017"
MONGODB_DB_NAME="rag_app_db"

# LLM/backends
GENERATION_BACKEND=OPENAI
EMBEDDING_BACKEND=OPENAI
GENERATION_MODEL_ID="gpt-4o-mini"
EMBEDDING_MODEL_ID="text-embedding-3-small"
EMBEDDING_MODEL_SIZE=1536

# Generation defaults
DEFAULT_INPUT_MAX_TOKENS=1024
DEFAULT_OUTPUT_MAX_TOKENS=200
DEFAULT_GENERATION_TEMPERATURE=0.1

# Vector DB
VECTOR_DB_BACKEND=PGVECTOR
VECTOR_DB_PATH="qdrant_data"
VECTOR_DB_DISTANCE_METHOD=COSINE
VECTOR_DBS_DIR="assets/vector_dbs"
